
# AI (typing and receipts). Server only: never prefix with NUXT_PUBLIC and never commit the real key.
# Free key from console.groq.com. Without it the AI features show an error.
GROQ_API_KEY=your-groq-key
# Optional. When set, receipt photos are read by Gemini (better with small print). Free key: aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: change the models (defaults shown).
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
